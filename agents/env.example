# SRE Agent Configuration
# Copy this file to .env and customize the values
# Static configurations (DB, ports, etc.) are set in docker-compose.yml

# =============================================================================
# SECRETS & API KEYS (Required)
# =============================================================================

# AI Model API Keys - REQUIRED for agent functionality
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Password - matches docker-compose postgres service
DB_PASSWORD=postgres

# Optional local run override. Docker Compose normally uses Postgres.
# SESSION_SERVICE_URI=sqlite:///./srebot_sessions.db

# =============================================================================
# USER-SPECIFIC CONFIGURATIONS
# =============================================================================

# AWS Configuration (user-specific)
AWS_PROFILE=your_aws_profile
AWS_REGION=us-east-1

# Kubernetes Configuration (user-specific)
KUBE_CONTEXT=your_kube_context
# Optional namespace default for Kubernetes tools
# KUBE_NAMESPACE=default

# =============================================================================
# DEVELOPMENT OVERRIDES (Optional)
# =============================================================================

# AI Model Selection (optional overrides)
# Priority order: Google > Anthropic > Bedrock
GOOGLE_AI_MODEL=gemini-2.0-flash

# Anthropic Claude Configuration (via LiteLLM)
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# AWS Bedrock Configuration (requires AWS credentials and billable Bedrock access)
# Use start-local-bedrock.ps1 to force Bedrock even when Google/Anthropic keys exist.
# BEDROCK_API_KEY=your_bedrock_api_key_here
# Or use the official AWS env var directly:
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
#
# Recommended cheap smoke-test model:
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# BEDROCK_REGION=us-east-1
#
# Advanced: application inference profile ARN for cost attribution/routing.
# BEDROCK_INFERENCE_PROFILE=arn:aws:bedrock:us-east-1:123456789012:application-inference-profile/example

# Local free model via Ollama (no API billing)
# Local PowerShell run:
# OLLAMA_API_BASE=http://localhost:11434
#
# Docker Compose run:
# Start Ollama on the host and use host.docker.internal from containers.
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_API_BASE=http://localhost:11434
# SRE_OLLAMA_SIMPLE_MODE=true

# Sub-agent feature flags
# In Ollama simple mode these are disabled automatically for stability.
SRE_ENABLE_AWS_COST_AGENT=true
SRE_ENABLE_AWS_CORE_AGENT=true
SRE_ENABLE_KUBERNETES_AGENT=true

# Logging Level Override (optional)
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=DEBUG

# Custom log format (optional)
# LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# =============================================================================
# AWS ROLE-BASED AUTHENTICATION (Advanced)
# =============================================================================

# Enable role-based authentication for cross-account AWS access
AWS_AUTH_ENABLE_CACHING=true
AWS_AUTH_CACHE_TTL=3000
AWS_AUTH_DEFAULT_REGION=us-east-1

# Simple single role configuration (uncomment and configure if needed)
# AWS_AUTH_DEFAULT_ROLE_ARN=arn:aws:iam::123456789012:role/SRERole
# AWS_AUTH_DEFAULT_ACCOUNT_ID=123456789012
# AWS_AUTH_DEFAULT_SESSION_NAME=SREBotSession

# Complex multi-role configuration (JSON format, uncomment if needed)
# AWS_AUTH_ROLES='{"prod": {"role_arn": "arn:aws:iam::111111111111:role/SRERole", "account_id": "111111111111"}, "staging": {"role_arn": "arn:aws:iam::222222222222:role/SRERole", "account_id": "222222222222"}}'
