# Slack Bot Configuration
# Copy this file to .env and customize the values
# Static configurations (ports, URLs, etc.) are set in docker-compose.yml

# =============================================================================
# SECRETS & TOKENS (Required)
# =============================================================================

# Slack App Configuration - REQUIRED for Slack integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# =============================================================================
# BEHAVIORAL CONFIGURATIONS
# =============================================================================

# API Communication Settings
API_TIMEOUT=300

# Session Management
SESSION_TIMEOUT_MINUTES=1200

# User Access Control (Optional)
WHITELIST_ENABLED=false
WHITELIST_USERS=

# =============================================================================
# DEVELOPMENT OVERRIDES (Optional)
# =============================================================================

# Logging Level Override (optional)
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=DEBUG

# Custom log format (optional)
# LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Override SRE Bot API URL (for external testing)
# SRE_BOT_API_URL=http://sre-bot-api:8001
